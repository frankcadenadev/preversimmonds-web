---
import { categories, icons, insurancesByCategory } from "../data/seguros";

const contactPreferences = [
  "Llamada telefónica",
  "WhatsApp",
  "Correo electrónico",
];

const stepLabels = ["Seguro", "Tus datos", "Detalles", "Confirmación"];
---

<div class="quote-wizard" data-wizard>
  <!-- Indicador de pasos -->
  <div class="wizard-steps">
    {
      stepLabels.map((label, index) => (
        <div class="wizard-step" data-step-indicator={index + 1}>
          <span class="step-circle">{index + 1}</span>
          <span class="step-label">{label}</span>
        </div>
      ))
    }
  </div>

  <form data-wizard-form>
    <!-- Paso 1: tipo de seguro -->
    <section class="wizard-panel" data-panel="1">
      <h3>¿Qué tipo de seguro necesitas?</h3>
      <p class="panel-subtitle">
        Selecciona la línea que más se ajuste a lo que buscas.
      </p>
      {
        categories.map((category) => (
          <div class="insurance-group">
            <p class="group-label">{category.label}</p>
            <div class="insurance-options">
              {insurancesByCategory(category.id).map((option) => (
                <label class="insurance-option">
                  <input
                    type="radio"
                    name="insurance-type"
                    value={option.slug}
                    data-label={option.name}
                    required
                  />
                  <span class="option-icon" aria-hidden="true">
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      set:html={icons[option.icon]}
                    />
                  </span>
                  <span class="option-label">{option.name}</span>
                </label>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <!-- Paso 2: datos de contacto -->
    <section class="wizard-panel" data-panel="2" hidden>
      <h3>Cuéntanos sobre ti</h3>
      <p class="panel-subtitle">
        Así podemos enviarte la cotización y hacerte seguimiento.
      </p>

      <div class="form-row">
        <div class="form-field">
          <label for="wiz-name"
            >Nombre completo <span class="required">*</span></label
          >
          <input
            type="text"
            id="wiz-name"
            name="name"
            placeholder="Tu nombre"
            required
          />
        </div>
        <div class="form-field">
          <label for="wiz-email"
            >Correo electrónico <span class="required">*</span></label
          >
          <input
            type="email"
            id="wiz-email"
            name="email"
            placeholder="tu@correo.com"
            required
          />
        </div>
      </div>
      <div class="form-field">
        <label for="wiz-phone"
          >Teléfono / WhatsApp <span class="required">*</span></label
        >
        <input
          type="tel"
          id="wiz-phone"
          name="phone"
          placeholder="300 000 0000"
          required
        />
      </div>
    </section>

    <!-- Paso 3: detalles adicionales -->
    <section class="wizard-panel" data-panel="3" hidden>
      <h3>Cuéntanos un poco más</h3>
      <p class="panel-subtitle">
        Esto nos ayuda a preparar una propuesta más precisa.
      </p>

      <div class="form-field">
        <label for="wiz-details">¿Qué necesitas cubrir? (opcional)</label>
        <textarea
          id="wiz-details"
          name="details"
          rows="4"
          placeholder="Cuéntanos cualquier detalle relevante..."></textarea>
      </div>

      <div class="form-field">
        <label
          >¿Cómo prefieres que te contactemos? <span class="required">*</span
          ></label
        >
        <div class="radio-list">
          {
            contactPreferences.map((pref, index) => (
              <label class="radio-option">
                <input
                  type="radio"
                  name="contact-preference"
                  value={pref}
                  required={index === 0}
                />
                <span>{pref}</span>
              </label>
            ))
          }
        </div>
      </div>

      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>
          Autorizo el tratamiento de mis datos personales conforme a la
          <a href="/politica" target="_blank" rel="noopener"
            >Política de Tratamiento de Datos Personales</a
          >.
        </span>
      </label>
    </section>

    <!-- Paso 4: confirmación -->
    <section class="wizard-panel" data-panel="4" hidden>
      <h3>Revisa tu solicitud</h3>
      <p class="panel-subtitle">
        Confirma que todo esté correcto antes de enviar.
      </p>

      <dl class="summary-list" data-summary>
        <div>
          <dt>Tipo de seguro</dt>
          <dd data-summary-field="insurance-type">—</dd>
        </div>
        <div>
          <dt>Nombre</dt>
          <dd data-summary-field="name">—</dd>
        </div>
        <div>
          <dt>Correo</dt>
          <dd data-summary-field="email">—</dd>
        </div>
        <div>
          <dt>Teléfono</dt>
          <dd data-summary-field="phone">—</dd>
        </div>
        <div>
          <dt>Contacto preferido</dt>
          <dd data-summary-field="contact-preference">—</dd>
        </div>
      </dl>
    </section>

    <!-- Estado final: enviado -->
    <section class="wizard-panel wizard-success" data-panel="success" hidden>
      <span class="success-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
          <path
            d="M20 6L9 17l-5-5"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <h3>¡Último paso!</h3>
      <p>
        Abrimos WhatsApp con tu solicitud. Pulsa <strong>enviar</strong> en el chat
        para que uno de nuestros asesores te responda.
      </p>
      <a
        href="#"
        class="btn btn-primary whatsapp-btn"
        data-whatsapp-fallback
        target="_blank"
        rel="noopener"
      >
        Abrir WhatsApp
      </a>
    </section>

    <!-- Navegación -->
    <div class="wizard-nav" data-wizard-nav>
      <button
        type="button"
        class="btn btn-outline-navy"
        data-action="back"
        hidden>Atrás</button
      >
      <button type="button" class="btn btn-primary" data-action="next"
        >Continuar</button
      >
      <button type="submit" class="btn btn-primary" data-action="submit" hidden
        >Enviar solicitud</button
      >
    </div>
  </form>
</div>

<style>
  .quote-wizard {
    background: var(--white);
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(16, 26, 48, 0.08);
    padding: 48px;
    max-width: 720px;
    margin: 0 auto;
  }

  /* Indicador de pasos */
  .wizard-steps {
    display: flex;
    justify-content: space-between;
    margin-bottom: 40px;
    position: relative;
  }

  .wizard-steps::before {
    content: "";
    position: absolute;
    top: 16px;
    left: 6%;
    right: 6%;
    height: 2px;
    background: #e4e7ec;
    z-index: 0;
  }

  .wizard-step {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 1;
  }

  .step-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid #e4e7ec;
    color: var(--gray-600);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    transition: all 0.2s ease;
  }

  .step-label {
    font-size: 12.5px;
    color: var(--gray-600);
    text-align: center;
  }

  .wizard-step.is-active .step-circle {
    background: var(--orange-500);
    border-color: var(--orange-500);
    color: var(--white);
  }

  .wizard-step.is-active .step-label {
    color: var(--navy-800);
    font-weight: 600;
  }

  .wizard-step.is-complete .step-circle {
    background: var(--navy-800);
    border-color: var(--navy-800);
    color: var(--white);
  }

  /* Paneles */
  .wizard-panel h3 {
    color: var(--navy-800);
    font-size: 24px;
    margin-bottom: 8px;
  }

  .panel-subtitle {
    color: var(--gray-600);
    font-size: 15px;
    margin-bottom: 28px;
  }

  .insurance-group + .insurance-group {
    margin-top: 24px;
  }

  .group-label {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gray-600);
    margin-bottom: 12px;
  }

  .insurance-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .insurance-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px;
    border: 1.5px solid #e4e7ec;
    border-radius: 14px;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .insurance-option:has(input:checked) {
    border-color: var(--orange-500);
    background: rgba(232, 134, 46, 0.06);
  }

  .insurance-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .option-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--navy-700);
    color: var(--orange-500);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .option-label {
    font-weight: 600;
    color: var(--navy-800);
    font-size: 15px;
  }

  /* Formularios (reutiliza estilo similar a QuoteForm) */
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
  }

  .form-field label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .required {
    color: var(--orange-500);
  }

  .form-field input,
  .form-field textarea {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 12px 14px;
    border: 1px solid #d8dce3;
    border-radius: 10px;
    color: var(--ink);
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--orange-500);
    box-shadow: 0 0 0 3px rgba(232, 134, 46, 0.15);
  }

  .radio-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .radio-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid #e4e7ec;
    border-radius: 10px;
    cursor: pointer;
    font-size: 14.5px;
    color: var(--ink);
  }

  .radio-option:has(input:checked) {
    border-color: var(--orange-500);
    background: rgba(232, 134, 46, 0.06);
  }

  /* Resumen */
  .summary-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }

  .summary-list > div {
    display: flex;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid #eef0f3;
  }

  .summary-list dt {
    color: var(--gray-600);
    font-size: 14px;
  }

  .summary-list dd {
    margin: 0;
    color: var(--navy-800);
    font-weight: 600;
    font-size: 14px;
    text-align: right;
  }

  /* Consentimiento */
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 24px;
    font-size: 13.5px;
    color: var(--gray-600);
    cursor: pointer;
  }

  .consent input {
    margin-top: 3px;
    accent-color: var(--orange-500);
    flex-shrink: 0;
  }

  .consent a {
    color: var(--orange-500);
    text-decoration: underline;
  }

  /* Éxito */
  .wizard-success {
    text-align: center;
    padding: 24px 0;
  }

  .success-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(232, 134, 46, 0.15);
    color: var(--orange-500);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .wizard-success p {
    color: var(--gray-600);
    font-size: 15px;
    margin-bottom: 24px;
  }

  .whatsapp-btn {
    justify-content: center;
  }

  /* Navegación */
  .wizard-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 32px;
  }

  .wizard-nav [hidden] {
    display: none;
  }

  .wizard-nav .btn-primary {
    margin-left: auto;
    border: none;
    cursor: pointer;
  }

  .btn-outline-navy {
    background: transparent;
    color: var(--navy-800);
    border: 1px solid #d8dce3;
    cursor: pointer;
  }

  .btn-outline-navy:hover {
    background: var(--gray-100);
  }

  @media (max-width: 640px) {
    .quote-wizard {
      padding: 28px 22px;
    }
    .form-row,
    .insurance-options {
      grid-template-columns: 1fr;
    }
    .step-label {
      display: none;
    }
  }
</style>

<script>
  import { buildWhatsAppUrl } from "../data/contacto";
  function setupQuoteWizard() {
    const wizard = document.querySelector("[data-wizard]") as HTMLElement;
    if (wizard) {
      const form = wizard.querySelector(
        "[data-wizard-form]",
      ) as HTMLFormElement;
      const panels = Array.from(
        wizard.querySelectorAll("[data-panel]"),
      ) as HTMLElement[];
      const stepIndicators = Array.from(
        wizard.querySelectorAll("[data-step-indicator]"),
      ) as HTMLElement[];
      const backBtn = wizard.querySelector(
        '[data-action="back"]',
      ) as HTMLButtonElement;
      const nextBtn = wizard.querySelector(
        '[data-action="next"]',
      ) as HTMLButtonElement;
      const submitBtn = wizard.querySelector(
        '[data-action="submit"]',
      ) as HTMLButtonElement;

      let currentStep = 1;
      const totalSteps = 4;

      function getPanel(step: number | "success") {
        return panels.find((p) => p.dataset.panel === String(step));
      }

      function updateStepIndicators() {
        stepIndicators.forEach((el) => {
          const step = Number(el.dataset.stepIndicator);
          el.classList.toggle("is-active", step === currentStep);
          el.classList.toggle("is-complete", step < currentStep);
        });
      }

      function showStep(step: number) {
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== String(step);
        });
        currentStep = step;
        updateStepIndicators();
        backBtn.hidden = step === 1;
        nextBtn.hidden = step === totalSteps;
        submitBtn.hidden = step !== totalSteps;

        if (step === totalSteps) {
          fillSummary();
        }
      }

      function validateCurrentPanel(): boolean {
        const panel = getPanel(currentStep);
        if (!panel) return true;

        // Campos de texto/select requeridos (no radios)
        const plainFields = Array.from(
          panel.querySelectorAll(
            'input:not([type="radio"])[required], select[required]',
          ),
        ) as HTMLInputElement[];
        for (const field of plainFields) {
          if (!field.checkValidity()) {
            field.reportValidity();
            return false;
          }
        }

        // Grupos de radio: si algún miembro del grupo es "required", el grupo completo
        // necesita al menos una opción marcada (así no todos los radios necesitan el atributo).
        const allRadios = Array.from(
          panel.querySelectorAll('input[type="radio"]'),
        ) as HTMLInputElement[];
        const radioGroups = new Set(allRadios.map((r) => r.name));
        for (const groupName of radioGroups) {
          const groupFields = allRadios.filter((r) => r.name === groupName);
          const isRequired = groupFields.some((r) => r.required);
          if (isRequired && !groupFields.some((r) => r.checked)) {
            groupFields[0].reportValidity();
            return false;
          }
        }

        return true;
      }

      const insuranceLabels: Record<string, string> = {
        vida: "Seguro de Vida",
        salud: "Seguro de Salud",
        auto: "Seguro de Vehículos",
        empresarial: "Seguro Empresarial",
      };

      function checkedInsuranceLabel(): string {
        const checked = form.querySelector(
          'input[name="insurance-type"]:checked',
        ) as HTMLInputElement | null;
        return checked?.dataset.label ?? "—";
      }

      function fillSummary() {
        const data = new FormData(form);
        const checkedInsurance = form.querySelector(
          'input[name="insurance-type"]:checked',
        ) as HTMLInputElement | null;
        const map: Record<string, string> = {
          "insurance-type": checkedInsurance?.dataset.label ?? "—",
          name: data.get("name")?.toString() ?? "—",
          email: data.get("email")?.toString() ?? "—",
          phone: data.get("phone")?.toString() ?? "—",
          "contact-preference":
            data.get("contact-preference")?.toString() ?? "—",
        };
        Object.entries(map).forEach(([key, value]) => {
          const el = wizard.querySelector(`[data-summary-field="${key}"]`);
          if (el) el.textContent = value;
        });
      }

      nextBtn.addEventListener("click", () => {
        if (!validateCurrentPanel()) return;
        if (currentStep < totalSteps) showStep(currentStep + 1);
      });

      backBtn.addEventListener("click", () => {
        if (currentStep > 1) showStep(currentStep - 1);
      });

      form.addEventListener("submit", (event) => {
              event.preventDefault();

      const data = new FormData(form);
      const value = (key: string) => (data.get(key) ?? '').toString().trim();
      const details = value('details');
      const url = buildWhatsAppUrl([
        'Hola, quiero solicitar una cotización.',
        '',
        `Seguro: ${checkedInsuranceLabel()}`,
        `Nombre: ${value('name')}`,
        `Correo: ${value('email')}`,
        `Teléfono: ${value('phone')}`,
        `Prefiero que me contacten por: ${value('contact-preference')}`,
        ...(details ? [`Detalles: ${details}`] : []),
        '',
        'Autorizo el tratamiento de mis datos personales según la política de Prever Seguros.',
      ]);

      window.open(url, '_blank', 'noopener');
      const fallbackLink = wizard.querySelector('[data-whatsapp-fallback]') as HTMLAnchorElement | null;
      if (fallbackLink) fallbackLink.href = url;
        panels.forEach((panel) => (panel.hidden = true));
        const successPanel = getPanel("success");
        if (successPanel) successPanel.hidden = false;

        const navEl = wizard.querySelector(
          "[data-wizard-nav]",
        ) as HTMLElement | null;
        const stepsEl = wizard.querySelector(
          ".wizard-steps",
        ) as HTMLElement | null;
        if (navEl) navEl.style.display = "none";
        if (stepsEl) stepsEl.style.display = "none";
      });

      // Si llegan desde la página de un seguro (?linea=slug), lo dejamos seleccionado y pasamos al paso 2.
      const preset = new URLSearchParams(window.location.search).get("linea");
      const presetRadio = preset
        ? (form.querySelector(
            `input[name="insurance-type"][value="${preset}"]`,
          ) as HTMLInputElement | null)
        : null;
      if (presetRadio) {
        presetRadio.checked = true;
        showStep(2);
      } else {
        showStep(1);
      }
    }
  }

  // Se ejecuta en la carga inicial y también tras cada transición de página (View Transitions)
  setupQuoteWizard();
  document.addEventListener("astro:after-swap", setupQuoteWizard);
</script>
