---
const insuranceOptions = [
  { value: 'vida', label: 'Seguro de Vida', icon: 'heart' },
  { value: 'salud', label: 'Seguro de Salud', icon: 'shield' },
  { value: 'auto', label: 'Seguro de Vehículos', icon: 'car' },
  { value: 'empresarial', label: 'Seguro Empresarial', icon: 'briefcase' },
];

const contactPreferences = ['Llamada telefónica', 'WhatsApp', 'Correo electrónico'];

const icons: Record<string, string> = {
  heart: '<path d="M12 21s-7-4.5-9.5-9C.5 8.5 2 5 5.5 5c2 0 3.5 1.2 4.5 2.5C11 6.2 12.5 5 14.5 5 18 5 19.5 8.5 21.5 12c-2.5 4.5-9.5 9-9.5 9z" fill="currentColor"/>',
  shield: '<path d="M12 2l7 3v6c0 5-3.4 8.5-7 10-3.6-1.5-7-5-7-10V5l7-3z" fill="currentColor"/>',
  car: '<path d="M5 11l1.5-4.5A2 2 0 0 1 8.4 5h7.2a2 2 0 0 1 1.9 1.5L19 11m-14 0h14m-14 0a2 2 0 0 0-2 2v4h2m14-6a2 2 0 0 1 2 2v4h-2M7 17a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>',
  briefcase: '<rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.6" fill="none"/>',
};

const stepLabels = ['Seguro', 'Tus datos', 'Detalles', 'Confirmación'];
---

<div class="quote-wizard" data-wizard>
  <!-- Indicador de pasos -->
  <div class="wizard-steps">
    {stepLabels.map((label, index) => (
      <div class="wizard-step" data-step-indicator={index + 1}>
        <span class="step-circle">{index + 1}</span>
        <span class="step-label">{label}</span>
      </div>
    ))}
  </div>

  <form data-wizard-form>
    <!-- Paso 1: tipo de seguro -->
    <section class="wizard-panel" data-panel="1">
      <h3>¿Qué tipo de seguro necesitas?</h3>
      <p class="panel-subtitle">Selecciona la línea que más se ajuste a lo que buscas.</p>

      <div class="insurance-options">
        {insuranceOptions.map((option) => (
          <label class="insurance-option">
            <input type="radio" name="insurance-type" value={option.value} required />
            <span class="option-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={icons[option.icon]} />
            </span>
            <span class="option-label">{option.label}</span>
          </label>
        ))}
      </div>
    </section>

    <!-- Paso 2: datos de contacto -->
    <section class="wizard-panel" data-panel="2" hidden>
      <h3>Cuéntanos sobre ti</h3>
      <p class="panel-subtitle">Así podemos enviarte la cotización y hacerte seguimiento.</p>

      <div class="form-row">
        <div class="form-field">
          <label for="wiz-name">Nombre completo <span class="required">*</span></label>
          <input type="text" id="wiz-name" name="name" placeholder="Tu nombre" required />
        </div>
        <div class="form-field">
          <label for="wiz-email">Correo electrónico <span class="required">*</span></label>
          <input type="email" id="wiz-email" name="email" placeholder="tu@correo.com" required />
        </div>
      </div>
      <div class="form-field">
        <label for="wiz-phone">Teléfono / WhatsApp <span class="required">*</span></label>
        <input type="tel" id="wiz-phone" name="phone" placeholder="300 000 0000" required />
      </div>
    </section>

    <!-- Paso 3: detalles adicionales -->
    <section class="wizard-panel" data-panel="3" hidden>
      <h3>Cuéntanos un poco más</h3>
      <p class="panel-subtitle">Esto nos ayuda a preparar una propuesta más precisa.</p>

      <div class="form-field">
        <label for="wiz-details">¿Qué necesitas cubrir? (opcional)</label>
        <textarea id="wiz-details" name="details" rows="4" placeholder="Cuéntanos cualquier detalle relevante..."></textarea>
      </div>

      <div class="form-field">
        <label>¿Cómo prefieres que te contactemos? <span class="required">*</span></label>
        <div class="radio-list">
          {contactPreferences.map((pref, index) => (
            <label class="radio-option">
              <input type="radio" name="contact-preference" value={pref} required={index === 0} />
              <span>{pref}</span>
            </label>
          ))}
        </div>
      </div>
    </section>

    <!-- Paso 4: confirmación -->
    <section class="wizard-panel" data-panel="4" hidden>
      <h3>Revisa tu solicitud</h3>
      <p class="panel-subtitle">Confirma que todo esté correcto antes de enviar.</p>

      <dl class="summary-list" data-summary>
        <div>
          <dt>Tipo de seguro</dt>
          <dd data-summary-field="insurance-type">—</dd>
        </div>
        <div>
          <dt>Nombre</dt>
          <dd data-summary-field="name">—</dd>
        </div>
        <div>
          <dt>Correo</dt>
          <dd data-summary-field="email">—</dd>
        </div>
        <div>
          <dt>Teléfono</dt>
          <dd data-summary-field="phone">—</dd>
        </div>
        <div>
          <dt>Contacto preferido</dt>
          <dd data-summary-field="contact-preference">—</dd>
        </div>
      </dl>
    </section>

    <!-- Estado final: enviado -->
    <section class="wizard-panel wizard-success" data-panel="success" hidden>
      <span class="success-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
          <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h3>¡Solicitud enviada!</h3>
      <p>Uno de nuestros asesores te contactará en menos de 24 horas.</p>
    </section>

    <!-- Navegación -->
    <div class="wizard-nav" data-wizard-nav>
      <button type="button" class="btn btn-outline-navy" data-action="back" hidden>Atrás</button>
      <button type="button" class="btn btn-primary" data-action="next">Continuar</button>
      <button type="submit" class="btn btn-primary" data-action="submit" hidden>Enviar solicitud</button>
    </div>
  </form>
</div>

<style>
  .quote-wizard {
    background: var(--white);
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(16, 26, 48, 0.08);
    padding: 48px;
    max-width: 720px;
    margin: 0 auto;
  }

  /* Indicador de pasos */
  .wizard-steps {
    display: flex;
    justify-content: space-between;
    margin-bottom: 40px;
    position: relative;
  }

  .wizard-steps::before {
    content: '';
    position: absolute;
    top: 16px;
    left: 6%;
    right: 6%;
    height: 2px;
    background: #e4e7ec;
    z-index: 0;
  }

  .wizard-step {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 1;
  }

  .step-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid #e4e7ec;
    color: var(--gray-600);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    transition: all 0.2s ease;
  }

  .step-label {
    font-size: 12.5px;
    color: var(--gray-600);
    text-align: center;
  }

  .wizard-step.is-active .step-circle {
    background: var(--orange-500);
    border-color: var(--orange-500);
    color: var(--white);
  }

  .wizard-step.is-active .step-label {
    color: var(--navy-800);
    font-weight: 600;
  }

  .wizard-step.is-complete .step-circle {
    background: var(--navy-800);
    border-color: var(--navy-800);
    color: var(--white);
  }

  /* Paneles */
  .wizard-panel h3 {
    color: var(--navy-800);
    font-size: 24px;
    margin-bottom: 8px;
  }

  .panel-subtitle {
    color: var(--gray-600);
    font-size: 15px;
    margin-bottom: 28px;
  }

  .insurance-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .insurance-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px;
    border: 1.5px solid #e4e7ec;
    border-radius: 14px;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .insurance-option:has(input:checked) {
    border-color: var(--orange-500);
    background: rgba(232, 134, 46, 0.06);
  }

  .insurance-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .option-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--navy-700);
    color: var(--orange-500);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .option-label {
    font-weight: 600;
    color: var(--navy-800);
    font-size: 15px;
  }

  /* Formularios (reutiliza estilo similar a QuoteForm) */
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
  }

  .form-field label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .required {
    color: var(--orange-500);
  }

  .form-field input,
  .form-field textarea {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 12px 14px;
    border: 1px solid #d8dce3;
    border-radius: 10px;
    color: var(--ink);
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--orange-500);
    box-shadow: 0 0 0 3px rgba(232, 134, 46, 0.15);
  }

  .radio-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .radio-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid #e4e7ec;
    border-radius: 10px;
    cursor: pointer;
    font-size: 14.5px;
    color: var(--ink);
  }

  .radio-option:has(input:checked) {
    border-color: var(--orange-500);
    background: rgba(232, 134, 46, 0.06);
  }

  /* Resumen */
  .summary-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }

  .summary-list > div {
    display: flex;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid #eef0f3;
  }

  .summary-list dt {
    color: var(--gray-600);
    font-size: 14px;
  }

  .summary-list dd {
    margin: 0;
    color: var(--navy-800);
    font-weight: 600;
    font-size: 14px;
    text-align: right;
  }

  /* Éxito */
  .wizard-success {
    text-align: center;
    padding: 24px 0;
  }

  .success-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(232, 134, 46, 0.15);
    color: var(--orange-500);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .wizard-success p {
    color: var(--gray-600);
    font-size: 15px;
  }

  /* Navegación */
  .wizard-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 32px;
  }

  .wizard-nav [hidden] {
    display: none;
  }

  .wizard-nav .btn-primary {
    margin-left: auto;
    border: none;
    cursor: pointer;
  }

  .btn-outline-navy {
    background: transparent;
    color: var(--navy-800);
    border: 1px solid #d8dce3;
    cursor: pointer;
  }

  .btn-outline-navy:hover {
    background: var(--gray-100);
  }

  @media (max-width: 640px) {
    .quote-wizard {
      padding: 28px 22px;
    }
    .form-row,
    .insurance-options {
      grid-template-columns: 1fr;
    }
    .step-label {
      display: none;
    }
  }
</style>

<script>
  const wizard = document.querySelector('[data-wizard]') as HTMLElement;
  if (wizard) {
    const form = wizard.querySelector('[data-wizard-form]') as HTMLFormElement;
    const panels = Array.from(wizard.querySelectorAll('[data-panel]')) as HTMLElement[];
    const stepIndicators = Array.from(wizard.querySelectorAll('[data-step-indicator]')) as HTMLElement[];
    const backBtn = wizard.querySelector('[data-action="back"]') as HTMLButtonElement;
    const nextBtn = wizard.querySelector('[data-action="next"]') as HTMLButtonElement;
    const submitBtn = wizard.querySelector('[data-action="submit"]') as HTMLButtonElement;

    let currentStep = 1;
    const totalSteps = 4;

    function getPanel(step: number | 'success') {
      return panels.find((p) => p.dataset.panel === String(step));
    }

    function updateStepIndicators() {
      stepIndicators.forEach((el) => {
        const step = Number(el.dataset.stepIndicator);
        el.classList.toggle('is-active', step === currentStep);
        el.classList.toggle('is-complete', step < currentStep);
      });
    }

    function showStep(step: number) {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== String(step);
      });
      currentStep = step;
      updateStepIndicators();
      backBtn.hidden = step === 1;
      nextBtn.hidden = step === totalSteps;
      submitBtn.hidden = step !== totalSteps;

      if (step === totalSteps) {
        fillSummary();
      }
    }

    function validateCurrentPanel(): boolean {
      const panel = getPanel(currentStep);
      if (!panel) return true;

      // Campos de texto/select requeridos (no radios)
      const plainFields = Array.from(
        panel.querySelectorAll('input:not([type="radio"])[required], select[required]')
      ) as HTMLInputElement[];
      for (const field of plainFields) {
        if (!field.checkValidity()) {
          field.reportValidity();
          return false;
        }
      }

      // Grupos de radio: si algún miembro del grupo es "required", el grupo completo
      // necesita al menos una opción marcada (así no todos los radios necesitan el atributo).
      const allRadios = Array.from(panel.querySelectorAll('input[type="radio"]')) as HTMLInputElement[];
      const radioGroups = new Set(allRadios.map((r) => r.name));
      for (const groupName of radioGroups) {
        const groupFields = allRadios.filter((r) => r.name === groupName);
        const isRequired = groupFields.some((r) => r.required);
        if (isRequired && !groupFields.some((r) => r.checked)) {
          groupFields[0].reportValidity();
          return false;
        }
      }

      return true;
    }

    const insuranceLabels: Record<string, string> = {
      vida: 'Seguro de Vida',
      salud: 'Seguro de Salud',
      auto: 'Seguro de Vehículos',
      empresarial: 'Seguro Empresarial',
    };

    function fillSummary() {
      const data = new FormData(form);
      const insuranceValue = data.get('insurance-type')?.toString() ?? '';
      const map: Record<string, string> = {
        'insurance-type': insuranceLabels[insuranceValue] ?? '—',
        name: data.get('name')?.toString() ?? '—',
        email: data.get('email')?.toString() ?? '—',
        phone: data.get('phone')?.toString() ?? '—',
        'contact-preference': data.get('contact-preference')?.toString() ?? '—',
      };
      Object.entries(map).forEach(([key, value]) => {
        const el = wizard.querySelector(`[data-summary-field="${key}"]`);
        if (el) el.textContent = value;
      });
    }

    nextBtn.addEventListener('click', () => {
      if (!validateCurrentPanel()) return;
      if (currentStep < totalSteps) showStep(currentStep + 1);
    });

    backBtn.addEventListener('click', () => {
      if (currentStep > 1) showStep(currentStep - 1);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      // TODO: aquí falta conectar el envío real (correo, CRM, backend propio).
      panels.forEach((panel) => (panel.hidden = true));
      const successPanel = getPanel('success');
      if (successPanel) successPanel.hidden = false;

      const navEl = wizard.querySelector('[data-wizard-nav]') as HTMLElement | null;
      const stepsEl = wizard.querySelector('.wizard-steps') as HTMLElement | null;
      if (navEl) navEl.style.display = 'none';
      if (stepsEl) stepsEl.style.display = 'none';
    });

    showStep(1);
  }
</script>