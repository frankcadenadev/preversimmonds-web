---
const team = [
  { name: 'Sebastián Simmonds', role: 'Gerencia General' },
  { name: 'Yenny Rodríguez', role: 'Socia fundadora' },
  { name: 'Alba Rodríguez', role: 'Seguros Generales y Empresariales' },
  { name: 'Valeria Herrera', role: 'Gestora de Bienestar' },
  { name: 'Fernanda Grisales', role: 'Especialista de Movilidad' },
  { name: 'Ana García', role: 'Cumplimiento y Movilidad' },
  { name: 'Erika Cuartas', role: 'Gestión Comercial' },
  { name: 'Camilo Sáenz', role: 'Gestión Administrativa' },
];

function getInitials(name: string) {
  return name
    .split(' ')
    .filter((part) => part.length > 0)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
}
---

<section class="team-section">
  <div class="container">
    <div class="team-heading">
      <p class="eyebrow">Nuestro equipo</p>
      <h2>Las personas detrás de Prever Seguros</h2>
      <p class="subtitle">Un equipo cercano y comprometido, listo para acompañarte en cada decisión.</p>
    </div>

    <div class="team-grid">
      {team.map((member) => (
        <div class="team-card">
          <div class="avatar" aria-hidden="true">
            <!-- Placeholder con iniciales: reemplazar por foto real cuando esté disponible -->
            <span>{getInitials(member.name)}</span>
          </div>
          <h3>{member.name}</h3>
          <p class="role">{member.role}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team-section {
    background: var(--white);
    padding: 88px 0;
  }

  .team-heading {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 48px;
  }

  .team-heading .eyebrow {
    color: var(--orange-500);
    font-weight: 600;
    font-size: 15px;
    margin-bottom: 12px;
  }

  .team-heading h2 {
    color: var(--navy-800);
    font-size: 32px;
    margin-bottom: 14px;
  }

  .team-heading .subtitle {
    color: var(--gray-600);
    font-size: 16px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px 24px;
  }

  .team-card {
    text-align: center;
  }

  .avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    margin: 0 auto 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
    color: var(--orange-500);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }

  .team-card h3 {
    color: var(--navy-800);
    font-size: 16px;
    margin-bottom: 4px;
  }

  .team-card .role {
    color: var(--gray-600);
    font-size: 13.5px;
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>