---
const currentYear = new Date().getFullYear();

const productLinks = [
  { label: 'Seguro de Vida', href: '/seguros/vida' },
  { label: 'Seguro de Salud', href: '/seguros/salud' },
  { label: 'Seguro de Vehículos', href: '/seguros/auto' },
  { label: 'Seguro Empresarial', href: '/seguros/empresariales' },
];

const companyLinks = [
  { label: 'Sobre Nosotros', href: '/nosotros' },
  { label: 'Nuestros Valores', href: '/nosotros#valores' },
  { label: 'Contacto', href: '/contacto' },
  { label: 'Cotizar', href: '/cotizar' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="brand-name">Prever Seguros</p>
      <p class="brand-desc">
        Protegemos lo que más importa. Más de 15 años acompañando a familias y empresas en
        Colombia con soluciones de seguros confiables.
      </p>
      <div class="social-links">
        <a href="#" aria-label="Facebook" class="social-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 9h3V5h-3c-2.2 0-4 1.8-4 4v2H7v4h3v6h4v-6h3l1-4h-4V9c0-.6.4-1 1-1z" fill="currentColor"/></svg>
        </a>
        <a href="#" aria-label="Instagram" class="social-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg>
        </a>
        <a href="#" aria-label="LinkedIn" class="social-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M7.5 10v6M7.5 7.5v.01M12 16v-3.5c0-1.4 1-2.5 2.5-2.5s2 1.1 2 2.5V16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer-col">
      <p class="footer-heading">Nuestros seguros</p>
      <ul>
        {productLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col">
      <p class="footer-heading">Empresa</p>
      <ul>
        {companyLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col">
      <p class="footer-heading">Contacto</p>
      <ul class="contact-list">
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.5 21 3 13.5 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" fill="currentColor"/></svg>
          <span>601 234 5678</span>
        </li>
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>info@preverseguros.com.co</span>
        </li>
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-6.6 7-11.5S15.9 3 12 3 5 5.6 5 9.5 12 21 12 21z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="9.5" r="2.3" stroke="currentColor" stroke-width="1.6"/></svg>
          <span>Bogotá D.C., Colombia</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {currentYear} Prever Seguros. Todos los derechos reservados.</p>
      <div class="footer-legal">
        <a href="/politica-de-tratamiento-de-datos">Política de privacidad</a>
        <a href="/terminos-y-condiciones">Términos y condiciones</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-800);
    color: rgba(255, 255, 255, 0.75);
    padding-top: 64px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
  }

  .footer-brand .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--white);
    margin-bottom: 14px;
  }

  .brand-desc {
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 20px;
    max-width: 320px;
  }

  .social-links {
    display: flex;
    gap: 10px;
  }

  .social-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-heading {
    color: var(--white);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col a {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-col a:hover {
    color: var(--orange-500);
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }

  .contact-list svg {
    color: var(--orange-500);
    flex-shrink: 0;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 22px 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
  }

  .footer-legal {
    display: flex;
    gap: 24px;
  }

  .footer-legal a:hover {
    color: var(--orange-500);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>