---
const insuranceTypes = ['Seguro de Vida', 'Seguro de Salud', 'Seguro de Vehículos', 'Seguro Empresarial', 'No estoy seguro / quiero asesoría'];
---

<div class="quote-form-card">
  <h3>Solicita tu cotización</h3>
  <p class="form-subtitle">Completa el formulario y te enviamos una propuesta personalizada.</p>

  <!--
    TODO: este formulario todavía no envía datos a ningún lado.
    Falta decidir el destino (correo, CRM, backend propio) antes de conectarlo.
  -->
  <form class="quote-form">
    <div class="form-row">
      <div class="form-field">
        <label for="name">Nombre completo <span class="required">*</span></label>
        <input type="text" id="name" name="name" placeholder="Tu nombre" required />
      </div>
      <div class="form-field">
        <label for="email">Correo electrónico <span class="required">*</span></label>
        <input type="email" id="email" name="email" placeholder="tu@correo.com" required />
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label for="phone">Teléfono / WhatsApp</label>
        <input type="tel" id="phone" name="phone" placeholder="300 000 0000" />
      </div>
      <div class="form-field">
        <label for="insurance-type">Tipo de seguro <span class="required">*</span></label>
        <select id="insurance-type" name="insurance-type" required>
          <option value="" selected disabled>Selecciona un seguro</option>
          {insuranceTypes.map((type) => (
            <option value={type}>{type}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="form-field">
      <label for="message">Cuéntanos más (opcional)</label>
      <textarea id="message" name="message" rows="4" placeholder="¿Qué necesitas cubrir? ¿Tienes alguna pregunta específica?"></textarea>
    </div>

    <button type="submit" class="btn btn-primary submit-btn">Enviar solicitud</button>

    <p class="form-disclaimer">
      Al enviar este formulario aceptas nuestra <a href="/politica-de-tratamiento-de-datos">política de privacidad</a>. No compartimos tu información con terceros.
    </p>
  </form>
</div>

<style>
  .quote-form-card {
    background: var(--white);
    border-radius: 20px;
    box-shadow: 0 12px 28px rgba(16, 26, 48, 0.06);
    padding: 40px;
  }

  .quote-form-card h3 {
    color: var(--navy-800);
    font-size: 22px;
    margin-bottom: 8px;
  }

  .form-subtitle {
    color: var(--gray-600);
    font-size: 15px;
    margin-bottom: 28px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
  }

  .form-row .form-field {
    margin-bottom: 0;
  }

  .form-field label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .required {
    color: var(--orange-500);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 12px 14px;
    border: 1px solid #d8dce3;
    border-radius: 10px;
    color: var(--ink);
    background: var(--white);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #9aa1ad;
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--orange-500);
    box-shadow: 0 0 0 3px rgba(232, 134, 46, 0.15);
  }

  .form-field textarea {
    resize: vertical;
  }

  .submit-btn {
    width: 100%;
    justify-content: center;
    border: none;
    cursor: pointer;
    font-size: 16px;
    padding: 15px 28px;
  }

  .form-disclaimer {
    color: var(--gray-600);
    font-size: 13px;
    text-align: center;
    margin-top: 16px;
  }

  .form-disclaimer a {
    color: var(--orange-500);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .quote-form-card {
      padding: 28px 22px;
    }
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>