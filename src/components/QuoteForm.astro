---
import { categories, insurancesByCategory } from '../data/seguros';
---

<div class="quote-form-card">
  <h3>Solicita tu cotización</h3>
  <p class="form-subtitle">Completa el formulario y te enviamos una propuesta personalizada.</p>

  <form class="quote-form" data-quote-form>
    <div class="form-row">
      <div class="form-field">
        <label for="name">Nombre completo <span class="required">*</span></label>
        <input type="text" id="name" name="name" placeholder="Tu nombre" required />
      </div>
      <div class="form-field">
        <label for="email">Correo electrónico <span class="required">*</span></label>
        <input type="email" id="email" name="email" placeholder="tu@correo.com" required />
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label for="phone">Teléfono / WhatsApp</label>
        <input type="tel" id="phone" name="phone" placeholder="300 000 0000" />
      </div>
      <div class="form-field">
        <label for="insurance-type">Tipo de seguro <span class="required">*</span></label>
        <select id="insurance-type" name="insurance-type" required>
          <option value="" selected disabled>Selecciona un seguro</option>
          {categories.map((category) => (
            <optgroup label={category.label}>
              {insurancesByCategory(category.id).map((item) => (
                <option value={item.name}>{item.name}</option>
              ))}
            </optgroup>
          ))}
          <option value="No estoy seguro / quiero asesoría">No estoy seguro / quiero asesoría</option>
        </select>
      </div>
    </div>

    <div class="form-field">
      <label for="message">Cuéntanos más (opcional)</label>
      <textarea id="message" name="message" rows="4" placeholder="¿Qué necesitas cubrir? ¿Tienes alguna pregunta específica?"></textarea>
    </div>

    <label class="consent">
      <input type="checkbox" name="consent" required />
      <span>
        Autorizo el tratamiento de mis datos personales conforme a la
        <a href="/politica" target="_blank" rel="noopener">Política de Tratamiento de Datos Personales</a>.
        <span class="required">*</span>
      </span>
    </label>

    <button type="submit" class="btn btn-primary submit-btn">Enviar solicitud por WhatsApp</button>

    <p class="form-feedback" data-form-feedback hidden>
      Abrimos WhatsApp con tu solicitud. Pulsa <strong>enviar</strong> en el chat para que un asesor te responda.
      ¿No se abrió? <a href="#" data-whatsapp-fallback target="_blank" rel="noopener">Ábrelo aquí</a>.
    </p>
  </form>
</div>

<style>
  .quote-form-card {
    background: var(--white);
    border-radius: 20px;
    box-shadow: 0 12px 28px rgba(16, 26, 48, 0.06);
    padding: 40px;
  }

  .quote-form-card h3 {
    color: var(--navy-800);
    font-size: 22px;
    margin-bottom: 8px;
  }

  .form-subtitle {
    color: var(--gray-600);
    font-size: 15px;
    margin-bottom: 28px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
  }

  .form-row .form-field {
    margin-bottom: 0;
  }

  .form-field label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .required {
    color: var(--orange-500);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 12px 14px;
    border: 1px solid #d8dce3;
    border-radius: 10px;
    color: var(--ink);
    background: var(--white);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #9aa1ad;
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--orange-500);
    box-shadow: 0 0 0 3px rgba(232, 134, 46, 0.15);
  }

  .form-field textarea {
    resize: vertical;
  }

  .submit-btn {
    width: 100%;
    justify-content: center;
    border: none;
    cursor: pointer;
    font-size: 16px;
    padding: 15px 28px;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 20px;
    font-size: 13.5px;
    color: var(--gray-600);
    cursor: pointer;
  }

  .consent input {
    margin-top: 3px;
    accent-color: var(--orange-500);
    flex-shrink: 0;
  }

  .consent a {
    color: var(--orange-500);
    text-decoration: underline;
  }

  .form-feedback {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: 10px;
    background: rgba(232, 134, 46, 0.1);
    color: var(--navy-800);
    font-size: 14px;
    text-align: center;
  }

  .form-feedback[hidden] {
    display: none;
  }

  .form-feedback a {
    color: var(--orange-500);
    font-weight: 600;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .quote-form-card {
      padding: 28px 22px;
    }
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

<script>
  import { buildWhatsAppUrl } from '../data/contacto';

  function setupQuoteForm() {
    const form = document.querySelector('[data-quote-form]') as HTMLFormElement | null;
    if (!form) return;

    const feedback = form.querySelector('[data-form-feedback]') as HTMLElement | null;
    const fallback = form.querySelector('[data-whatsapp-fallback]') as HTMLAnchorElement | null;

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const value = (key: string) => (data.get(key) ?? '').toString().trim();
      const phone = value('phone');
      const message = value('message');

      const url = buildWhatsAppUrl([
        'Hola, quiero solicitar una cotización.',
        '',
        `Seguro: ${value('insurance-type')}`,
        `Nombre: ${value('name')}`,
        `Correo: ${value('email')}`,
        ...(phone ? [`Teléfono: ${phone}`] : []),
        ...(message ? [`Detalles: ${message}`] : []),
        '',
        'Autorizo el tratamiento de mis datos personales según la política de Prever Seguros.',
      ]);

      window.open(url, '_blank', 'noopener');

      if (fallback) fallback.href = url;
      if (feedback) feedback.hidden = false;
      form.reset();
    });
  }

  // astro:page-load se dispara en la carga inicial y después de cada navegación (View Transitions)
  document.addEventListener('astro:page-load', setupQuoteForm);
</script>