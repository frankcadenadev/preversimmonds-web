---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Productos', href: '/seguros' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' },
].map((item) => ({
  ...item,
  active: item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href),
}));

const phone = '???????'; // TODO: confirmar número real de atención con Sebastián/Camilo
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
  <img src="/images/logo.png" alt="Prever Simmonds" class="brand-logo" />
</a>

    <nav class="main-nav" aria-label="Navegación principal">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} class={item.active ? 'active' : ''}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={`tel:${phone.replace(/\D/g, '')}`} class="phone-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.5 21 3 13.5 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"
            fill="currentColor"
          />
        </svg>
        <span>{phone}</span>
      </a>
      <a href="/cotizar" class="btn btn-primary">Cotizar ahora</a>
    </div>
  </div>
</header>

<style>
  .site-header {
  background: var(--navy-700);
  position: sticky;
  top: 0;
  z-index: 10;
}

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--white);
  }

  .brand-logo {
  height: 50px;
  width: auto;
}

  .main-nav ul {
    list-style: none;
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    color: var(--white);
    font-size: 15px;
    font-weight: 500;
    opacity: 0.85;
  }

  .main-nav a:hover {
    opacity: 1;
  }

  .main-nav a.active {
    color: var(--orange-500);
    opacity: 1;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
  }

  .phone-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .main-nav {
      display: none;
    }
    .phone-link span {
      display: none;
    }
  }
</style>
