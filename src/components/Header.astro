---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Productos', href: '/seguros' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' },
].map((item) => ({
  ...item,
  active: item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href),
}));

const phone = 'xxx xxx xxxx'; // TODO: confirmar número real de atención con Sebastián/Camilo
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/images/logo.png" alt="Prever Simmonds" class="brand-logo" />
    </a>

    <nav class="main-nav" aria-label="Navegación principal" data-nav>
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} class={item.active ? 'active' : ''}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="mobile-nav-actions">
        <a href={`tel:${phone.replace(/\D/g, '')}`} class="phone-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.5 21 3 13.5 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"
              fill="currentColor"
            />
          </svg>
          <span>{phone}</span>
        </a>
        <a href="/cotizar" class="btn btn-primary">Cotizar ahora</a>
      </div>
    </nav>

    <div class="header-actions">
      <a href={`tel:${phone.replace(/\D/g, '')}`} class="phone-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.5 21 3 13.5 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"
            fill="currentColor"
          />
        </svg>
        <span>{phone}</span>
      </a>
      <a href="/cotizar" class="btn btn-primary">Cotizar ahora</a>

      <button type="button" class="menu-toggle" data-menu-toggle aria-label="Abrir menú" aria-expanded="false" aria-controls="main-nav-list">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="icon-open" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="icon-close" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--navy-700);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 50px;
    width: auto;
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    color: var(--white);
    font-size: 15px;
    font-weight: 500;
    opacity: 0.85;
  }

  .main-nav a:hover {
    opacity: 1;
  }

  .main-nav a.active {
    color: var(--orange-500);
    opacity: 1;
  }

  .mobile-nav-actions {
    display: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
  }

  .phone-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
    font-size: 14px;
    font-weight: 500;
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--white);
    padding: 4px;
    cursor: pointer;
  }

  .menu-toggle .icon-close {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (max-width: 900px) {
    .header-actions > .phone-link,
    .header-actions > .btn-primary {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .main-nav {
      position: fixed;
      top: 86px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--navy-700);
      padding: 32px 24px;
      overflow-y: auto;
      transform: translateY(-12px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .main-nav.is-open {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .main-nav ul {
      flex-direction: column;
      gap: 8px;
    }

    .main-nav ul a {
      display: block;
      padding: 14px 4px;
      font-size: 17px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .mobile-nav-actions {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-top: 24px;
    }

    .mobile-nav-actions .btn-primary {
      justify-content: center;
    }
  }
</style>

<script>
  function setupMenuToggle() {
    const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
    const nav = document.querySelector('[data-nav]') as HTMLElement | null;
    if (!toggle || !nav) return;

    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    // Cierra el menú al navegar a otra página (incluye clicks dentro del nav)
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
  }

  // Se ejecuta en la carga normal y también tras cada transición de página (View Transitions)
  setupMenuToggle();
  document.addEventListener('astro:after-swap', setupMenuToggle);
</script>