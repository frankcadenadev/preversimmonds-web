---
const stats = [
  { value: '30+', label: 'Años de experiencia' },
  { value: '50.000+', label: 'Familias protegidas' },
  { value: '98%', label: 'Clientes satisfechos' },
  { value: '24/7', label: 'Atención disponible' },
];

const features = [
  {
    title: 'Cobertura nacional',
    description: 'Presencia en todas las ciudades principales de Colombia con asesores locales.',
  },
  {
    title: 'Atención personalizada',
    description: 'Un asesor dedicado que entiende tu situación y te guía en cada decisión.',
  },
  {
    title: 'Respaldo sólido',
    description: 'Respaldados por las aseguradoras más reconocidas del mercado colombiano.',
  },
];
---

<section class="why-us">
  <div class="container">
    <div class="stats-row">
      {stats.map((stat) => (
        <div class="stat">
          <p class="stat-value">{stat.value}</p>
          <p class="stat-label">{stat.label}</p>
        </div>
      ))}
    </div>

    <div class="why-grid">
      <div class="why-content">
        <p class="eyebrow">Por qué elegirnos</p>
        <h2>Más de 15 años protegiendo lo que importa</h2>
        <p class="lead">
          No somos solo una aseguradora. Somos el aliado que te acompaña antes, durante y después
          de cualquier imprevisto.
        </p>
        <a href="/nosotros" class="btn btn-secondary">
          Conocer nuestra historia
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="feature-list">
        {features.map((feature) => (
          <div class="feature-card">
            <span class="feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .why-us {
    background: var(--navy-700);
    padding: 80px 0 96px;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
    padding-bottom: 64px;
    margin-bottom: 64px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stat-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    color: var(--orange-500);
    margin-bottom: 6px;
  }

  .stat-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .why-content .eyebrow {
    color: var(--orange-500);
    font-weight: 600;
    font-size: 15px;
    margin-bottom: 14px;
  }

  .why-content h2 {
    color: var(--white);
    font-size: 32px;
    margin-bottom: 18px;
  }

  .why-content .lead {
    color: rgba(255, 255, 255, 0.75);
    font-size: 16px;
    margin-bottom: 28px;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .feature-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 22px 24px;
  }

  .feature-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(232, 134, 46, 0.18);
    color: var(--orange-500);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    color: var(--white);
    font-size: 17px;
    margin-bottom: 6px;
  }

  .feature-card p {
    color: rgba(255, 255, 255, 0.65);
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .stats-row {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 32px;
    }
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
</style>