---
interface Props {
  icon: string;
  eyebrow: string;
  title: string;
  description: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
  reverse?: boolean;
}

const { icon, eyebrow, title, description, features, ctaLabel, ctaHref, reverse = false } = Astro.props;

const icons: Record<string, string> = {
  heart: '<path d="M12 21s-7-4.5-9.5-9C.5 8.5 2 5 5.5 5c2 0 3.5 1.2 4.5 2.5C11 6.2 12.5 5 14.5 5 18 5 19.5 8.5 21.5 12c-2.5 4.5-9.5 9-9.5 9z" fill="currentColor"/>',
  shield: '<path d="M12 2l7 3v6c0 5-3.4 8.5-7 10-3.6-1.5-7-5-7-10V5l7-3z" fill="currentColor"/>',
  car: '<path d="M5 11l1.5-4.5A2 2 0 0 1 8.4 5h7.2a2 2 0 0 1 1.9 1.5L19 11m-14 0h14m-14 0a2 2 0 0 0-2 2v4h2m14-6a2 2 0 0 1 2 2v4h-2M7 17a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>',
  briefcase: '<rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.6" fill="none"/>',
};
---

<section class={`product-detail ${reverse ? 'is-reverse' : ''}`}>
  <div class="container detail-grid">
    <div class="detail-image">
      <!-- Placeholder: reemplazar por fotografía real cuando la proporcione la empresa -->
      <span class="icon-badge" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" set:html={icons[icon]} />
      </span>
    </div>

    <div class="detail-content">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p class="description">{description}</p>

      <ul class="feature-checklist">
        {features.map((feature) => (
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" fill="rgba(232,134,46,0.12)" />
              <path d="M8 12.5l2.5 2.5L16 9.5" stroke="var(--orange-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>

      <a href={ctaHref} class="btn btn-primary">
        {ctaLabel}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .product-detail {
    padding: 72px 0;
  }

  .product-detail:nth-of-type(even) {
    background: var(--gray-100);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .is-reverse .detail-grid {
    direction: rtl;
  }

  .is-reverse .detail-grid > * {
    direction: ltr;
  }

  .detail-image {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  }

  .icon-badge {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--orange-500);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  }

  .detail-content .eyebrow {
    color: var(--orange-500);
    font-weight: 600;
    font-size: 15px;
    margin-bottom: 12px;
  }

  .detail-content h2 {
    color: var(--navy-800);
    font-size: 30px;
    margin-bottom: 16px;
  }

  .detail-content .description {
    color: var(--gray-600);
    font-size: 16px;
    margin-bottom: 24px;
  }

  .feature-checklist {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature-checklist li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-size: 15px;
  }

  .feature-checklist svg {
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
    .is-reverse .detail-grid {
      direction: ltr;
    }
  }
</style>