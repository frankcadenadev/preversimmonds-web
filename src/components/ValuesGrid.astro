---
const values = [
  {
    icon: 'shield',
    title: 'Confianza',
    description: 'Construimos relaciones de largo plazo basadas en la transparencia y el cumplimiento de nuestros compromisos.',
  },
  {
    icon: 'heart',
    title: 'Cercanía',
    description: 'Hablamos claro, sin tecnicismos. Estamos donde nos necesitas, cuando nos necesitas.',
  },
  {
    icon: 'award',
    title: 'Responsabilidad',
    description: 'Respondemos con agilidad y honestidad ante cada siniestro y cada consulta de nuestros clientes.',
  },
  {
    icon: 'zap',
    title: 'Innovación',
    description: 'Buscamos constantemente mejores formas de protegerte, adaptándonos a los cambios del mercado y de tu vida.',
  },
  {
    icon: 'users',
    title: 'Compromiso social',
    description: 'Creemos que el acceso a seguros dignos es un derecho, no un privilegio. Trabajamos para democratizarlo.',
  },
  {
    icon: 'star',
    title: 'Excelencia',
    description: 'Nos exigimos los más altos estándares en cada interacción, porque tu tranquilidad no admite mediocridad.',
  },
];

const icons: Record<string, string> = {
  shield: '<path d="M12 2l7 3v6c0 5-3.4 8.5-7 10-3.6-1.5-7-5-7-10V5l7-3z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>',
  heart: '<path d="M12 21s-7-4.5-9.5-9C.5 8.5 2 5 5.5 5c2 0 3.5 1.2 4.5 2.5C11 6.2 12.5 5 14.5 5 18 5 19.5 8.5 21.5 12c-2.5 4.5-9.5 9-9.5 9z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>',
  award: '<circle cx="12" cy="8" r="5" stroke="currentColor" stroke-width="1.7" fill="none"/><path d="M8.5 12.5L7 22l5-3 5 3-1.5-9.5" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>',
  zap: '<path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>',
  users: '<circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="1.7" fill="none"/><path d="M3.5 20c.7-3 3-5 5.5-5s4.8 2 5.5 5" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"/><path d="M15.5 6.5c1.5.3 2.5 1.6 2.5 3.1s-1 2.8-2.5 3.1M18 20c-.6-2.5-2-4.3-4-5" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"/>',
  star: '<path d="M12 3l2.6 5.9 6.4.6-4.8 4.3 1.4 6.2L12 16.9 6.4 20l1.4-6.2L3 9.5l6.4-.6L12 3z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>',
};
---

<section class="values-section">
  <div class="container">
    <div class="values-heading">
      <p class="eyebrow">Nuestros valores</p>
      <h2>Lo que nos guía cada día</h2>
    </div>

    <div class="values-grid">
      {values.map((value) => (
        <div class="value-card">
          <span class="value-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={icons[value.icon]} />
          </span>
          <h3>{value.title}</h3>
          <p>{value.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .values-section {
    background: var(--navy-700);
    padding: 88px 0;
  }

  .values-heading {
    text-align: center;
    margin-bottom: 48px;
  }

  .values-heading .eyebrow {
    color: var(--orange-500);
    font-weight: 600;
    font-size: 15px;
    margin-bottom: 12px;
  }

  .values-heading h2 {
    color: var(--white);
    font-size: 32px;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .value-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 28px;
  }

  .value-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(232, 134, 46, 0.16);
    color: var(--orange-500);
    margin-bottom: 20px;
  }

  .value-card h3 {
    color: var(--white);
    font-size: 18px;
    margin-bottom: 10px;
  }

  .value-card p {
    color: rgba(255, 255, 255, 0.65);
    font-size: 14.5px;
  }

  @media (max-width: 900px) {
    .values-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>