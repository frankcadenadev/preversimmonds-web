---
const products = [
  {
    title: 'Seguro de Vida',
    description:
      'Protege el futuro de tu familia con una cobertura que les da tranquilidad cuando más lo necesitan.',
    href: '/seguros/vida',
    icon: 'heart',
  },
  {
    title: 'Seguro de Salud',
    description:
      'Accede a atención médica de calidad sin preocuparte por los costos. Tu salud, siempre cubierta.',
    href: '/seguros/salud',
    icon: 'shield',
  },
  {
    title: 'Seguro de Vehículos',
    description:
      'Maneja con confianza. Cubrimos tu vehículo ante accidentes, robo y responsabilidad civil.',
    href: '/seguros/auto',
    icon: 'car',
  },
  {
    title: 'Seguro Empresarial',
    description:
      'Protege tu negocio, tus activos y a tu equipo con planes diseñados para empresas de todo tamaño.',
    href: '/seguros/empresariales',
    icon: 'briefcase',
  },
];

const icons: Record<string, string> = {
  heart: '<path d="M12 21s-7-4.5-9.5-9C.5 8.5 2 5 5.5 5c2 0 3.5 1.2 4.5 2.5C11 6.2 12.5 5 14.5 5 18 5 19.5 8.5 21.5 12c-2.5 4.5-9.5 9-9.5 9z" fill="currentColor"/>',
  shield: '<path d="M12 2l7 3v6c0 5-3.4 8.5-7 10-3.6-1.5-7-5-7-10V5l7-3z" fill="currentColor"/>',
  car: '<path d="M5 11l1.5-4.5A2 2 0 0 1 8.4 5h7.2a2 2 0 0 1 1.9 1.5L19 11m-14 0h14m-14 0a2 2 0 0 0-2 2v4h2m14-6a2 2 0 0 1 2 2v4h-2M7 17a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>',
  briefcase: '<rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.6" fill="none"/>',
};
---

<section class="products">
  <div class="container">
    <div class="products-heading">
      <p class="eyebrow">Nuestros seguros</p>
      <h2>Una solución para cada etapa de tu vida</h2>
      <p class="subtitle">
        Diseñamos coberturas que se adaptan a tus necesidades reales, con respaldo y claridad en cada paso.
      </p>
    </div>

    <div class="products-grid">
      {products.map((product, index) => (
          <article class="product-card reveal" style={`transition-delay: ${index * 120}ms`}>
          <div class="product-image">
            <!-- Placeholder: reemplazar por fotografía real cuando la proporcione la empresa -->
            <span class="icon-badge" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" set:html={icons[product.icon]} />
            </span>
          </div>
          <div class="product-body">
            <h3>{product.title}</h3>
            <p>{product.description}</p>
            <a href={product.href} class="product-link">
              Ver cobertura
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .products {
    padding: 96px 0;
    background: var(--white);
  }

  .products-heading {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 56px;
  }

  .products-heading .eyebrow {
    color: var(--orange-500);
    font-weight: 600;
    font-size: 15px;
    margin-bottom: 12px;
  }

  .products-heading h2 {
    color: var(--navy-800);
    font-size: 34px;
    margin-bottom: 16px;
  }

  .subtitle {
    color: var(--gray-600);
    font-size: 16px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .product-card {
    display: flex;
    flex-direction: column;
  }

  .reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

  .product-image {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    /* Placeholder visual en tonos de marca; reemplazar por foto real */
    background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
    margin-bottom: 20px;
  }

  .icon-badge {
    position: absolute;
    left: 16px;
    bottom: -16px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--orange-500);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .product-body h3 {
    color: var(--navy-800);
    font-size: 19px;
    margin-bottom: 10px;
  }

  .product-body p {
    color: var(--gray-600);
    font-size: 15px;
    margin-bottom: 16px;
  }

  .product-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--orange-500);
    font-weight: 600;
    font-size: 14px;
  }

  .product-link:hover {
    color: var(--orange-600);
  }

  @media (max-width: 960px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
    .products-heading h2 {
      font-size: 28px;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll('.product-card.reveal');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  cards.forEach((card) => observer.observe(card));
</script>


