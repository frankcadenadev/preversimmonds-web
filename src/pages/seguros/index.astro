---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import AdvisorCTA from '../../components/AdvisorCTA.astro';
import Footer from '../../components/Footer.astro';
import { categories, icons, insurancesByCategory } from '../../data/seguros';
---

<Layout title="Productos · Prever Seguros" description="Conoce todos los seguros que gestionamos: personas, vehículos y empresas. Comparamos varias aseguradoras para ti.">
  <Header />
  <PageHero
    eyebrow="Nuestros seguros"
    title="Cobertura para cada momento de tu vida"
    subtitle="Comparamos varias aseguradoras para encontrar el seguro que necesitas, con respaldo real y atención cercana."
  />

  <section class="catalog">
    <div class="container">
      {categories.map((category) => (
        <div class="category" id={category.id}>
          <div class="category-heading">
            <h2>{category.label}</h2>
            <p>{category.description}</p>
          </div>

          <div class="cards-grid">
            {insurancesByCategory(category.id).map((item) => (
              <a href={`/seguros/${item.slug}`} class="insurance-card">
                <span class="card-icon" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" set:html={icons[item.icon]} />
                </span>
                <h3>{item.name}</h3>
                <p>{item.summary}</p>
                <span class="card-link">
                  Ver más
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <HowItWorks />
  <AdvisorCTA />
  <Footer />
</Layout>

<style>
  .catalog {
    background: var(--gray-100);
    padding: 72px 0 40px;
  }

  .category {
    margin-bottom: 56px;
    scroll-margin-top: 100px;
  }

  .category-heading {
    margin-bottom: 28px;
  }

  .category-heading h2 {
    color: var(--navy-800);
    font-size: 28px;
    margin-bottom: 8px;
  }

  .category-heading p {
    color: var(--gray-600);
    font-size: 16px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .insurance-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 10px 24px rgba(16, 26, 48, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .insurance-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(16, 26, 48, 0.12);
  }

  .card-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--navy-700);
    color: var(--orange-500);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .insurance-card h3 {
    color: var(--navy-800);
    font-size: 19px;
    margin-bottom: 10px;
  }

  .insurance-card p {
    color: var(--gray-600);
    font-size: 14.5px;
    margin-bottom: 18px;
    flex-grow: 1;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--orange-500);
    font-weight: 600;
    font-size: 14px;
  }

  @media (max-width: 1060px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }

    .category-heading h2 {
      font-size: 24px;
    }
  }
</style>